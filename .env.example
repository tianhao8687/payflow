COMPOSE_PROJECT_NAME=payflow
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000
REDIS_PORT=6379
API_METRICS_PORT=9464
WORKER_METRICS_PORT=9465

# JWT and idempotent sandbox seed
JWT_SECRET=replace_me_with_at_least_32_characters
JWT_EXPIRES_IN_SECONDS=900
ENABLE_SWAGGER=false

# Stage 11 Alipay computer website pay. Disabled until sandbox secrets are
# injected by the process environment or a read-only secret mount.
ALIPAY_ENABLED=false
ALIPAY_ALLOW_PRODUCTION=false
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:4000/webhooks/alipay
ALIPAY_RETURN_URL=http://localhost:3000/payments/{paymentId}/result?provider=alipay
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_APP_CERT_CONTENT=
ALIPAY_ALIPAY_PUBLIC_CERT_CONTENT=
ALIPAY_ALIPAY_ROOT_CERT_CONTENT=
PAYFLOW_ADMIN_EMAIL=admin@payflow.local
PAYFLOW_ADMIN_PASSWORD=replace_with_a_strong_sandbox_password

# Stage 3 Stripe sandbox/test mode only; live keys are rejected
STRIPE_SECRET_KEY=

# Stage 4 webhook signing secret (Stripe CLI or sandbox endpoint)
STRIPE_WEBHOOK_SECRET=

# Stage 8 PayPal sandbox + Redis/BullMQ
REDIS_URL=redis://redis:6379
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
WEBHOOK_WORKER_CONCURRENCY=8
OUTBOX_WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=500
INBOX_POLL_INTERVAL_MS=500
PAYMENT_RECOVERY_INTERVAL_MS=15000
RECONCILIATION_INTERVAL_MS=900000
RECONCILIATION_LOOKBACK_MS=86400000
STRIPE_RECONCILIATION_KEY=

# Stage 10 observability. Leave the OTLP endpoint empty to keep spans local;
# set it to an OTLP/HTTP collector base URL when a trace backend is available.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_VERSION=0.11.0
