COMPOSE_PROJECT_NAME=payflow
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
POSTGRES_PORT=5432
API_PORT=4000
WEB_PORT=3000
REDIS_PORT=6379

# JWT and idempotent sandbox seed
JWT_SECRET=replace_me_with_at_least_32_characters
JWT_EXPIRES_IN_SECONDS=900
PAYFLOW_ADMIN_EMAIL=admin@payflow.local
PAYFLOW_ADMIN_PASSWORD=replace_with_a_strong_sandbox_password

# Stage 3 Stripe sandbox/test mode only; live keys are rejected
STRIPE_SECRET_KEY=

# Stage 4 webhook signing secret (Stripe CLI or sandbox endpoint)
STRIPE_WEBHOOK_SECRET=

# Stage 8 PayPal sandbox + Redis/BullMQ
REDIS_URL=redis://redis:6379
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
WEBHOOK_WORKER_CONCURRENCY=8
