{
  "name": "@payflow/api",
  "version": "0.1.0",
  "description": "PayFlow NestJS API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "pretest": "pnpm --filter @payflow/shared build && pnpm --filter @payflow/database build && pnpm --filter @payflow/payment-core build && pnpm --filter @payflow/payment-domain build && pnpm --filter @payflow/payment-paypal build && pnpm --filter @payflow/payment-queue build && pnpm --filter @payflow/payment-stripe build",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "pnpm --filter @payflow/shared build && pnpm --filter @payflow/database build && pnpm --filter @payflow/payment-core build && pnpm --filter @payflow/payment-domain build && pnpm --filter @payflow/payment-paypal build && pnpm --filter @payflow/payment-queue build && pnpm --filter @payflow/payment-stripe build",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:failure-lab": "jest --config ./test/jest-e2e.json --runInBand --runTestsByPath ./test/failure-lab.e2e-spec.ts",
    "test:stage-8": "jest --config ./test/jest-e2e.json --runInBand --runTestsByPath ./test/stage-8.e2e-spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@payflow/database": "workspace:*",
    "@payflow/payment-core": "workspace:*",
    "@payflow/payment-domain": "workspace:*",
    "@payflow/payment-paypal": "workspace:*",
    "@payflow/payment-queue": "workspace:*",
    "@payflow/payment-stripe": "workspace:*",
    "@payflow/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "stripe": "22.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
