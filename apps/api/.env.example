NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow?schema=public
APP_BASE_URL=http://localhost:3000

# Stage 1 authentication
JWT_SECRET=replace_me_with_at_least_32_characters
JWT_EXPIRES_IN_SECONDS=900

# Idempotent Stage 1 seed (sandbox only)
PAYFLOW_ADMIN_EMAIL=admin@payflow.local
PAYFLOW_ADMIN_PASSWORD=replace_with_a_strong_sandbox_password

# Stage 3-5 Stripe sandbox/test mode only; live keys are rejected at startup
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stage 8 providers and queue
REDIS_URL=redis://localhost:6379
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_WEBHOOK_ID=xxx
PAYPAL_ENV=sandbox

# Stage 10 observability
OTEL_SERVICE_NAME=payflow-api
