NODE_ENV=development
DATABASE_URL=postgresql://payflow:payflow@localhost:5432/payflow?schema=public
REDIS_URL=redis://localhost:6379
WEBHOOK_WORKER_CONCURRENCY=8
OUTBOX_WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=500
RECONCILIATION_INTERVAL_MS=900000
RECONCILIATION_LOOKBACK_MS=86400000

# Prefer a read-only Stripe test restricted key (rk_test_) with PaymentIntent
# lookup permission. A test secret key is accepted only for local fallback.
STRIPE_RECONCILIATION_KEY=

# Sandbox capture and reconciliation credentials. Webhook verification remains
# in the API.
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_ENV=sandbox

# Stage 10 observability
OTEL_SERVICE_NAME=payflow-worker
OTEL_SERVICE_VERSION=0.10.0
OTEL_METRICS_HOST=127.0.0.1
OTEL_METRICS_PORT=9465
OTEL_EXPORTER_OTLP_ENDPOINT=
