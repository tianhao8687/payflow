    "bcryptjs": "3.0.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "^5.9.3"
  }
}
