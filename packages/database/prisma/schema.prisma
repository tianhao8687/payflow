generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  ALIPAY
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

enum OutboxEventStatus {
  PENDING
  PUBLISHED
  PROCESSED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionType {
  PAYMENT
  REFUND
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
}

enum ReconciliationIssueStatus {
  OPEN
  RESOLVED
}

enum ReconciliationIssueType {
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  STATUS_MISMATCH
  REFUND_TOTAL_MISMATCH
}

model User {
  id                           String                @id @default(uuid()) @db.Uuid
  email                        String                @unique @db.VarChar(320)
  passwordHash                 String                @map("password_hash") @db.VarChar(100)
  role                         Role                  @default(USER)
  createdAt                    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  orders                       Order[]
  auditLogs                    AuditLog[]
  resolvedReconciliationIssues ReconciliationIssue[] @relation("ReconciliationIssueResolver")

  @@map("users")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  sku         String      @unique @db.VarChar(64)
  name        String      @db.VarChar(160)
  priceAmount Int         @map("price_amount")
  currency    String      @db.Char(3)
  stock       Int
  active      Boolean     @default(true)
  orderItems  OrderItem[]

  @@index([active])
  @@map("products")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  orderNo        String      @unique @map("order_no") @db.VarChar(32)
  status         OrderStatus @default(PENDING_PAYMENT)
  currency       String      @db.Char(3)
  subtotalAmount Int         @map("subtotal_amount")
  totalAmount    Int         @map("total_amount")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  skuSnapshot     String  @map("sku_snapshot") @db.VarChar(64)
  nameSnapshot    String  @map("name_snapshot") @db.VarChar(160)
  unitPriceAmount Int     @map("unit_price_amount")
  quantity        Int
  lineTotalAmount Int     @map("line_total_amount")
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                        String                @id @default(uuid()) @db.Uuid
  orderId                   String                @map("order_id") @db.Uuid
  provider                  PaymentProvider
  status                    PaymentStatus         @default(CREATED)
  amount                    Int
  currency                  String                @db.Char(3)
  providerPaymentId         String?               @map("provider_payment_id") @db.VarChar(255)
  providerCheckoutSessionId String?               @unique @map("provider_checkout_session_id") @db.VarChar(255)
  checkoutUrl               String?               @map("checkout_url") @db.Text
  checkoutExpiresAt         DateTime?             @map("checkout_expires_at") @db.Timestamptz(3)
  idempotencyKey            String                @unique @map("idempotency_key") @db.VarChar(255)
  attemptNo                 Int                   @map("attempt_no")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                     Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts                  PaymentAttempt[]
  refunds                   Refund[]
  reconciliationChecks      ReconciliationCheck[]
  reconciliationIssues      ReconciliationIssue[]

  @@unique([provider, providerPaymentId])
  @@unique([orderId, provider, attemptNo])
  @@index([orderId, createdAt])
  @@index([status])
  @@index([provider, status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  paymentId         String               @map("payment_id") @db.Uuid
  providerRequestId String?              @map("provider_request_id") @db.VarChar(255)
  status            PaymentAttemptStatus @default(STARTED)
  errorCode         String?              @map("error_code") @db.VarChar(100)
  errorMessage      String?              @map("error_message") @db.VarChar(500)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model WebhookEvent {
  id                      String             @id @default(uuid()) @db.Uuid
  provider                PaymentProvider
  providerEventId         String             @map("provider_event_id") @db.VarChar(255)
  eventType               String             @map("event_type") @db.VarChar(255)
  payloadJson             Json               @map("payload_json") @db.JsonB
  actionJson              Json?              @map("action_json") @db.JsonB
  status                  WebhookEventStatus @default(RECEIVED)
  deliveryCount           Int                @default(1) @map("delivery_count")
  processingAttempts      Int                @default(0) @map("processing_attempts")
  dispatchAttempts        Int                @default(0) @map("dispatch_attempts")
  dispatchError           String?            @map("dispatch_error") @db.VarChar(500)
  dispatchLeaseUntil      DateTime?          @map("dispatch_lease_until") @db.Timestamptz(3)
  nextDispatchAt          DateTime           @default(now()) @map("next_dispatch_at") @db.Timestamptz(3)
  processingError         String?            @map("processing_error") @db.VarChar(500)
  queueJobId              String?            @map("queue_job_id") @db.VarChar(255)
  receivedAt              DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  lastReceivedAt          DateTime           @default(now()) @map("last_received_at") @db.Timestamptz(3)
  providerOccurredAt      DateTime?          @map("provider_occurred_at") @db.Timestamptz(3)
  payloadHash             String?            @map("payload_hash") @db.VarChar(64)
  eventFingerprint        String?            @map("event_fingerprint") @db.VarChar(64)
  queuedAt                DateTime?          @map("queued_at") @db.Timestamptz(3)
  lastDispatchAttemptAt   DateTime?          @map("last_dispatch_attempt_at") @db.Timestamptz(3)
  lastProcessingStartedAt DateTime?          @map("last_processing_started_at") @db.Timestamptz(3)
  processedAt             DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([provider, receivedAt])
  @@index([status, receivedAt])
  @@index([status, queuedAt, nextDispatchAt, receivedAt, id], map: "webhook_events_dispatch_due_idx")
  @@index([eventType, receivedAt])
  @@index([queueJobId])
  @@map("webhook_events")
}

model Refund {
  id                    String       @id @default(uuid()) @db.Uuid
  paymentId             String       @map("payment_id") @db.Uuid
  refundRequestId       String       @map("refund_request_id") @db.Uuid
  providerRefundId      String?      @unique @map("provider_refund_id") @db.VarChar(255)
  amount                Int
  status                RefundStatus @default(PENDING)
  reason                String       @db.VarChar(500)
  idempotencyKey        String       @unique @map("idempotency_key") @db.VarChar(255)
  providerRequestId     String?      @map("provider_request_id") @db.VarChar(255)
  lastProviderAttemptAt DateTime?    @map("last_provider_attempt_at") @db.Timestamptz(3)
  failureCode           String?      @map("failure_code") @db.VarChar(100)
  failureMessage        String?      @map("failure_message") @db.VarChar(500)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment               Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, refundRequestId])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String         @db.VarChar(100)
  targetType   String         @map("target_type") @db.VarChar(100)
  targetId     String         @map("target_id") @db.VarChar(255)
  metadataJson Json           @map("metadata_json") @db.JsonB
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actor        User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  eventKey           String             @unique @map("event_key") @db.VarChar(255)
  aggregateType      String             @map("aggregate_type") @db.VarChar(100)
  aggregateId        String             @map("aggregate_id") @db.Uuid
  eventType          String             @map("event_type") @db.VarChar(100)
  payloadJson        Json               @map("payload_json") @db.JsonB
  status             OutboxEventStatus  @default(PENDING)
  publishAttempts    Int                @default(0) @map("publish_attempts")
  processingAttempts Int                @default(0) @map("processing_attempts")
  queueJobId         String?            @map("queue_job_id") @db.VarChar(255)
  lastError          String?            @map("last_error") @db.VarChar(500)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt        DateTime?          @map("published_at") @db.Timestamptz(3)
  processedAt        DateTime?          @map("processed_at") @db.Timestamptz(3)
  ledgerTransaction  LedgerTransaction?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
  @@index([queueJobId])
  @@map("outbox_events")
}

model LedgerAccount {
  id        String        @id @default(uuid()) @db.Uuid
  code      String        @db.VarChar(100)
  name      String        @db.VarChar(160)
  currency  String        @db.Char(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  entries   LedgerEntry[]

  @@unique([code, currency])
  @@index([currency, code])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  outboxEventId   String                @unique @map("outbox_event_id") @db.Uuid
  transactionType LedgerTransactionType @map("transaction_type")
  referenceType   String                @map("reference_type") @db.VarChar(100)
  referenceId     String                @map("reference_id") @db.Uuid
  currency        String                @db.Char(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  outboxEvent     OutboxEvent           @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  entries         LedgerEntry[]

  @@index([referenceType, referenceId, createdAt])
  @@index([transactionType, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  accountId     String            @map("account_id") @db.Uuid
  direction     LedgerDirection
  amount        Int
  currency      String            @db.Char(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([transactionId, accountId, direction])
  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model ReconciliationRun {
  id                  String                  @id @default(uuid()) @db.Uuid
  status              ReconciliationRunStatus @default(RUNNING)
  windowStart         DateTime                @map("window_start") @db.Timestamptz(3)
  windowEnd           DateTime                @map("window_end") @db.Timestamptz(3)
  checkedCount        Int                     @default(0) @map("checked_count")
  passedCount         Int                     @default(0) @map("passed_count")
  issueCount          Int                     @default(0) @map("issue_count")
  errorCount          Int                     @default(0) @map("error_count")
  pageCount           Int                     @default(0) @map("page_count")
  checkpointUpdatedAt DateTime?               @map("checkpoint_updated_at") @db.Timestamptz(3)
  checkpointPaymentId String?                 @map("checkpoint_payment_id") @db.Uuid
  startedAt           DateTime                @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?               @map("completed_at") @db.Timestamptz(3)
  checks              ReconciliationCheck[]
  issues              ReconciliationIssue[]

  @@index([startedAt])
  @@index([status, startedAt])
  @@map("reconciliation_runs")
}

model ReconciliationCheck {
  id               String                @id @default(uuid()) @db.Uuid
  runId            String                @map("run_id") @db.Uuid
  paymentId        String                @map("payment_id") @db.Uuid
  provider         PaymentProvider
  matched          Boolean
  localSnapshot    Json                  @map("local_snapshot") @db.JsonB
  providerSnapshot Json?                 @map("provider_snapshot") @db.JsonB
  error            String?               @db.VarChar(500)
  checkedAt        DateTime              @default(now()) @map("checked_at") @db.Timestamptz(3)
  run              ReconciliationRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  payment          Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issues           ReconciliationIssue[]

  @@unique([runId, paymentId])
  @@index([paymentId, checkedAt])
  @@index([matched, checkedAt])
  @@map("reconciliation_checks")
}

model ReconciliationIssue {
  id               String                    @id @default(uuid()) @db.Uuid
  runId            String                    @map("run_id") @db.Uuid
  checkId          String                    @map("check_id") @db.Uuid
  paymentId        String                    @map("payment_id") @db.Uuid
  provider         PaymentProvider
  issueType        ReconciliationIssueType   @map("issue_type")
  localSnapshot    Json                      @map("local_snapshot") @db.JsonB
  providerSnapshot Json                      @map("provider_snapshot") @db.JsonB
  status           ReconciliationIssueStatus @default(OPEN)
  detectedAt       DateTime                  @default(now()) @map("detected_at") @db.Timestamptz(3)
  lastSeenAt       DateTime                  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  resolvedAt       DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  resolvedById     String?                   @map("resolved_by_id") @db.Uuid
  run              ReconciliationRun         @relation(fields: [runId], references: [id], onDelete: Restrict)
  check            ReconciliationCheck       @relation(fields: [checkId], references: [id], onDelete: Restrict)
  payment          Payment                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  resolvedBy       User?                     @relation("ReconciliationIssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, detectedAt])
  @@index([provider, status, detectedAt])
  @@index([paymentId, detectedAt])
  @@index([runId])
  @@map("reconciliation_issues")
}
