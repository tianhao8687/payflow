generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum AuditActorType {
  ADMIN
  SYSTEM
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(320)
  passwordHash String     @map("password_hash") @db.VarChar(100)
  role         Role       @default(USER)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  orders       Order[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  sku         String      @unique @db.VarChar(64)
  name        String      @db.VarChar(160)
  priceAmount Int         @map("price_amount")
  currency    String      @db.Char(3)
  stock       Int
  active      Boolean     @default(true)
  orderItems  OrderItem[]

  @@index([active])
  @@map("products")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  orderNo        String      @unique @map("order_no") @db.VarChar(32)
  status         OrderStatus @default(PENDING_PAYMENT)
  currency       String      @db.Char(3)
  subtotalAmount Int         @map("subtotal_amount")
  totalAmount    Int         @map("total_amount")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  payments       Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  productId       String  @map("product_id") @db.Uuid
  skuSnapshot     String  @map("sku_snapshot") @db.VarChar(64)
  nameSnapshot    String  @map("name_snapshot") @db.VarChar(160)
  unitPriceAmount Int     @map("unit_price_amount")
  quantity        Int
  lineTotalAmount Int     @map("line_total_amount")
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                        String           @id @default(uuid()) @db.Uuid
  orderId                   String           @map("order_id") @db.Uuid
  provider                  PaymentProvider
  status                    PaymentStatus    @default(CREATED)
  amount                    Int
  currency                  String           @db.Char(3)
  providerPaymentId         String?          @map("provider_payment_id") @db.VarChar(255)
  providerCheckoutSessionId String?          @unique @map("provider_checkout_session_id") @db.VarChar(255)
  checkoutUrl               String?          @map("checkout_url") @db.Text
  checkoutExpiresAt         DateTime?        @map("checkout_expires_at") @db.Timestamptz(3)
  idempotencyKey            String           @unique @map("idempotency_key") @db.VarChar(255)
  attemptNo                 Int              @map("attempt_no")
  createdAt                 DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                     Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts                  PaymentAttempt[]
  refunds                   Refund[]

  @@unique([provider, providerPaymentId])
  @@unique([orderId, provider, attemptNo])
  @@index([orderId, createdAt])
  @@index([status])
  @@index([provider, status, createdAt])
  @@map("payments")
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  paymentId         String               @map("payment_id") @db.Uuid
  providerRequestId String?              @map("provider_request_id") @db.VarChar(255)
  status            PaymentAttemptStatus @default(STARTED)
  errorCode         String?              @map("error_code") @db.VarChar(100)
  errorMessage      String?              @map("error_message") @db.VarChar(500)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model WebhookEvent {
  id              String             @id @default(uuid()) @db.Uuid
  provider        PaymentProvider
  providerEventId String             @unique @map("provider_event_id") @db.VarChar(255)
  eventType       String             @map("event_type") @db.VarChar(255)
  payloadJson     Json               @map("payload_json") @db.JsonB
  status          WebhookEventStatus @default(RECEIVED)
  deliveryCount   Int                @default(1) @map("delivery_count")
  processingError String?            @map("processing_error") @db.VarChar(500)
  receivedAt      DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  lastReceivedAt  DateTime           @default(now()) @map("last_received_at") @db.Timestamptz(3)
  processedAt     DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@index([provider, receivedAt])
  @@index([status, receivedAt])
  @@index([eventType, receivedAt])
  @@map("webhook_events")
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  refundRequestId   String       @map("refund_request_id") @db.Uuid
  providerRefundId  String?      @unique @map("provider_refund_id") @db.VarChar(255)
  amount            Int
  status            RefundStatus @default(PENDING)
  reason            String       @db.VarChar(500)
  idempotencyKey    String       @unique @map("idempotency_key") @db.VarChar(255)
  providerRequestId String?      @map("provider_request_id") @db.VarChar(255)
  failureCode       String?      @map("failure_code") @db.VarChar(100)
  failureMessage    String?      @map("failure_message") @db.VarChar(500)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, refundRequestId])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
  @@map("refunds")
}

model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String         @db.VarChar(100)
  targetType   String         @map("target_type") @db.VarChar(100)
  targetId     String         @map("target_id") @db.VarChar(255)
  metadataJson Json           @map("metadata_json") @db.JsonB
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actor        User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
